# EditorConfig —— https://editorconfig.org
# 统一各编辑器的缩进、换行与末尾空白。

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{go,js,jsx,ts,tsx,json,yml,yaml,css,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_size = 4

[*.ps1]
indent_size = 4
end_of_line = crlf
