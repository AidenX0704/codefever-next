# CodeFever Next —— nginx 站点配置（Go 后端）
#
# PHP 后端下线后，本文件是**唯一**的站点配置（原先的 PHP 版 vhost.conf-template
# 已随 PHP 运行时一起删除）。
#
# 要点：
#   1. 应用层路径（/api /apiv1 /user /file /doc /lang /captcha 等）全部反向代理
#      到 Go 后端 http://127.0.0.1:9001。
#   2. 静态资源与 SPA 回退由 nginx 托管 www/app（新前端 web/build 的产物；
#      2026-10 前端重写后由 Dockerfile 直接 COPY 成真实目录，不再经 view/build 软链）。
#   3. 应用层 GET（/user/login、/doc/* 等）**不再返回 SSR HTML** —— Go 侧统一下发
#      SPA 壳（www/app/index.html），见 backend/internal/httpapi/spa.go。
#   4. 仓库名正则放宽，允许连字符 —— 与 Go 后端及 Go 网关统一；
#      PHP 版的三层正则不一致（nginx 拒绝 `-`、Go 网关接受、PHP 拒绝）
#      是已知缺陷，见 docs/ARCHITECTURE_ANALYSIS.md §4.6。
#
# 无需任何切换开关：镜像里只有 Go 后端。

server_names_hash_max_size 512;
server_names_hash_bucket_size 128;

server {
    listen 80;
    server_name localhost;
    index index.html index.htm;
    root /data/www/codefever-community/www/;

    # ---------------------------------------------------------------------
    # 压缩（2026-10 性能整改 A1）
    #
    # 基础镜像 webdevops/php-nginx 的主 nginx.conf 里 gzip 是**注释状态**
    # （容器内 `nginx -T` 可见 `#gzip  on;`），因此必须在本 vhost 显式开启，
    # 否则全站 JS/CSS/JSON 均以原文传输。
    #
    # 实测（www/view/build 产物，gzip -6）：
    #   vendor 1,131,004 B -> 353,609 B
    #   main     568,343 B ->  99,160 B
    #   css        3,628 B ->   1,407 B
    #   合计 1,702,975 B -> 454,176 B（-73.3%）
    #
    # 注意：
    #   * text/html 默认总会被压缩，无需列入 gzip_types。
    #   * 不要加入 image/png、image/jpeg、font/woff —— 这些格式本身已压缩，
    #     二次压缩反而变大。
    #   * 本镜像未编译 ngx_brotli（`nginx -V` 只带 gzip_static），而 brotli 相对
    #     gzip 仅再省约 42 KB，故不引入。
    #   * gzip_static 由 --with-http_gzip_static_module 提供：若构建期预压 .gz，
    #     nginx 直接下发，可省掉每请求的压缩 CPU。
    # ---------------------------------------------------------------------
    gzip              on;
    gzip_vary         on;
    gzip_comp_level   6;
    gzip_min_length   1024;
    gzip_proxied      any;
    gzip_types        text/plain text/css text/xml
                      application/javascript application/json application/xml
                      image/svg+xml application/font-woff application/font-woff2
                      application/vnd.ms-fontobject;
    gzip_static       on;

    # Git over HTTP —— 转发给 codefever-http-gateway（127.0.0.1:27555）。
    #
    # 大仓库 push 的 pack 可能远超 nginx 默认的 1MB 请求体上限，
    # 因此这里显式关闭上限，并放宽读写超时。
    #
    # 注意：不要开 `proxy_request_buffering off`。Go 的 net/http/cgi 会拒绝
    # Transfer-Encoding: chunked 的请求；关闭缓冲后 nginx 可能把大 pack 以
    # chunked 转发，push 会直接 400。默认的 on 会先缓冲并补上 Content-Length。
    location ~* ^\/[0-9a-z_.-]+\/[0-9a-z_.-]+\.git {
        proxy_pass http://127.0.0.1:27555;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 0;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # ---------------------------------------------------------------------
    # 静态资源缓存策略（2026-10 性能整改 A2）
    #
    # 三类路径，缓存强度不同：
    #   1. /static/js/、/static/css/ —— webpack 产物，文件名带内容哈希
    #      （main.3a8cdea3.js），内容变则 URL 变，可放心 immutable 一年。
    #   2. 其它 /static/ —— 含登录页的 vendor 目录与 /static/{ReleaseNumber}/
    #      版本目录。版本目录本身带发布号，但 vendor 目录不带，故 7 天 +
    #      stale-while-revalidate，兼顾更新时效与二次访问。
    #   3. 其余（SPA 回退）—— index.html 必须每次校验，否则发布后用户
    #      会一直加载旧壳（旧壳引用的哈希文件已被删除 → 白屏）。
    #
    # 注意两个 nginx 语义坑：
    #   * 不要同时写 `expires` 与 `add_header Cache-Control` —— 会输出两条
    #     Cache-Control 头。这里统一只用 add_header。
    #   * add_header 不继承：某 location 内一旦出现 add_header，server 级的
    #     add_header 全部失效。若将来新增安全响应头，必须逐 location 补齐。
    # ---------------------------------------------------------------------

    # 带内容哈希的构建产物 —— 永久缓存。
    location ^~ /static/js/ {
        rewrite "(.*)\.map(.*)" "/static/not/found" last;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri /app$uri 404;
    }
    location ^~ /static/css/ {
        rewrite "(.*)\.map(.*)" "/static/not/found" last;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri /app$uri 404;
    }

    # 其余静态资源（vendor、按发布号分版本的自有静态）。
    location ^~ /static/ {
        rewrite "(.*)\.map(.*)" "/static/not/found" last;
        rewrite "^/static/\d{14}/(.*)$" "/static/$1" last;
        add_header Cache-Control "public, max-age=604800, stale-while-revalidate=86400" always;
        try_files $uri /app$uri 404;
    }

    # 应用层：API、内部网关回调、服务端渲染页面、文件下载。
    location ~* ^/(user|file|feature|doc|community|lang|captcha|boss|service|pricing|api(v\d+)?)?(\/.*)?$ {
        proxy_pass http://127.0.0.1:9001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        # 头像等文件上传上限，与 PHP 侧的 20MB 保持一致。
        client_max_body_size 20m;
    }

    # SPA history 路由回退。
    #
    # index.html 必须每次回源校验（no-cache = 可缓存但每次协商），
    # 否则前端发布后用户会长期持有旧壳，而旧壳引用的哈希文件已不存在。
    # 注：/user/*、/doc/* 等应用层 GET 走上面的 proxy_pass，由 Go 下发同一份壳（自带 no-cache）。
    location / {
        add_header Cache-Control "no-cache" always;
        try_files $uri /app/index.html;
    }
}
