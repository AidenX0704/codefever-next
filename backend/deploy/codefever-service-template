#!/bin/bash

# chkconfig: 2345 50 20
#
# CodeFever Next 的 Git over HTTP 网关服务脚本（VM / 非容器部署用）。
# 容器部署由 supervisor 管理，不使用本脚本。

BASE=/data/www/codefever-community

# PHP 时代的 modify_authorized_keys 守护进程已下线 —— authorized_keys
# 现在由 Go 后端（backend/internal/authkeys）直接写。

HTTP_GATEWAY=$BASE/bin/codefever-http-gateway
PIDFILE=/var/run/codefever-http-gateway.pid

# 只取 users.git，避免匹配到 mysql 段或 cli.git。
GIT_USER=$(sed -n '/^users:[[:space:]]*$/,/^[^[:space:]]/p' "$BASE/env.yaml" |
    sed -n 's/^[[:space:]]*git:[[:space:]]*//p' | head -n 1 |
    sed "s/^[\"']//; s/[\"']$//")

start()
{
   if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
      echo "CodeFever HTTP gateway already running (pid $(cat "$PIDFILE"))"
      exit 0
   fi
   echo "Starting CodeFever HTTP gateway ..."
   sudo -u "${GIT_USER:-git}" nohup "$HTTP_GATEWAY" -base "$BASE" >/dev/null 2>&1 &
   echo $! > "$PIDFILE"
   echo "Started (pid $(cat "$PIDFILE"))"
   exit 0
}

stop()
{
   echo "Stopping CodeFever HTTP gateway ..."
   if [ -f "$PIDFILE" ]; then
      kill -TERM "$(cat "$PIDFILE")" 2>/dev/null || true
      rm -f "$PIDFILE"
   fi
   echo "Stopped"
   exit 0
}

status()
{
   if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
      echo "CodeFever HTTP gateway: Running (pid $(cat "$PIDFILE"))"
      exit 0
   fi
   echo "CodeFever HTTP gateway: Stopped"
   exit 3
}

case "$1" in
   start)   start ;;
   stop)    stop ;;
   restart) stop; start ;;
   status)  status ;;
   *)
      echo "Usage: $0 {start|stop|restart|status}"
      exit 1
   ;;
esac
