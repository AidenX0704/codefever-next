# 排除与镜像构建无关的内容, 减小构建上下文
.git
**/.git
.gitignore
.gitattributes
.editorconfig

# 文档与社区治理文件 (运行期不需要；doc/ 例外，应用内文档中心要读)
docs/
scripts/
.github/
CONTRIBUTING.md
CODE_OF_CONDUCT.md
SECURITY.md
CHANGELOG.md
LOCAL_DEPLOY.md
README.md
README_EN.md

# 前端源码 (构建产物已随仓库提交, 运行时不需要 src)
www/view/src/

# 新前端（2026-10 重写）：只需要 web/build 与 web/public
web/node_modules/
web/src/
web/scripts/
web/.tmp-lang/
web/package-lock.json
www/view/config/
www/view/scripts/
www/view/package.json
www/view/yarn.lock
www/view/.gitignore
# 前端依赖 (仅本地构建时需要, 体积数百 MB, 绝不能进镜像)
www/view/node_modules/

# 本地构建产物
dist/
*.tar
.tmp-*
NUL
www/view/.tmp-build-check/

# 运行时数据卷（构建上下文里不应包含真实仓库/附件）
git-storage/
file-storage/
codefever-data/

# 本地真实配置（必须由模板在构建期重新生成；绝不能把本地密钥带进构建上下文）
config.yaml
env.yaml
node_modules/

# Go 后端的本地构建产物与测试基线（镜像运行时不需要，仓库里仍然保留）
backend/bin/
backend/testdata/
backend/*.exe
backend/tmp_*.go
backend/.tmp-*
backend/.gotmp/
