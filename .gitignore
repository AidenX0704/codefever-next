!*/

.vscode
.idea
.DS_Store

# Agent 运行时状态（会话 hook 快照、任务评审报告等），仅本机使用，不入库
# 不锚定根目录：子目录（如 web/.mimosa/）也会产生同类状态文件，2026-10-26 曾误入库
.mimosa/

# 仅供本机参考的分析材料，不入库
/docs/local/

# 运行时配置 (由 template 复制而来, 含随机 session key / gateway token, 不入库)
/env.yaml
/config.yaml
/node_modules

/www/robots.txt
/www/view/node_modules
/www/view/npm-debug.log*
/www/view/yarn-debug.log*
/www/view/yarn-error.log*
/www/view/.tmp-build-check/

# 运行时数据（源码部署时由 deploy/sql/create_db.sh 或容器入口创建）
/file-storage/**
/git-storage/**
# Compose 默认数据目录（MySQL / 裸仓库 / 附件 / 配置）
/codefever-data/

# 本地镜像构建产物
/dist/
/.tmp-*
/NUL

# Go 后端 (backend/)
/backend/bin/
/backend/testdata/collected/
# 本地交叉编译产物 (Windows) 与临时源码
/backend/*.exe
/backend/tmp_*.go
/backend/.tmp-*
/backend/.gotmp/

# 临时文件
/cookies.txt
/cookies_test.txt

# docker-data
docker-data/
